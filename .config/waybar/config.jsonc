{
    "include": [
        "/usr/share/sway/templates/waybar/config.jsonc",
    ],
    "modules-left": [
        "custom/menu",
        "sway/workspaces",
        "custom/scratchpad",
        "custom/playerctl",
    ],
    "modules-center": [
        "custom/wf-recorder",
        "sway/mode",
        "custom/weather",
    ],
    "modules-right": [
        // informational
        "sway/language",
        //"custom/github",
        "custom/clipboard",
        "custom/zeit",
        "cpu",
        "temperature",
        "memory",
        "battery",

        // connecting
        "network",
        "bluetooth",
        "custom/valent",

        // media
        "custom/idle_inhibitor",
        "custom/dnd",
        "pulseaudio",
        "backlight",

        // system
        "custom/adaptive-light",
        "custom/sunset",
        "custom/pacman",

        "tray",
        "clock"
    ],

    "custom/playerctl": {
        "max-length": 80,
        "interval": 1,
        "tooltip": true,
        "return-type": "json",
        "format": "♫ {} {icon}",
        "format-icons": {
            "Playing": "",
            "Paused": ""
        },
        "exec": "playerctl metadata --format '{\"alt\": \"{{status}}\", \"text\": \"{{duration(position)}} {{trunc(markup_escape(title), 30)}}\", \"tooltip\": \"{{playerName}}:  {{markup_escape(title)}} - {{markup_escape(artist)}}\", \"class\": [\"{{lc(status)}}\"] }'",

        //"exec": "$HOME/.config/waybar/mediaplayer.sh",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous",
        "on-scroll-up": "playerctl position 10+",
        "on-scroll-down": "playerctl position 10-",
        "signal": 5
    },

    "pulseaudio": {
        "scroll-step": 5,
        "format": "{icon} {volume}%{format_source}",
        "format-muted": "󰖁 {format_source}",
        "format-source": "",
        "format-source-muted": " 󰍭",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋎",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "tooltip-format": "{icon}  {volume}% {format_source}",
        //"on-click": "swaymsg exec \\$pulseaudio",
        "on-click": "swaymsg exec \\$TERMINAL_COMMAND ncpamixer",
        "on-click-middle": "swaymsg exec \\$volume_mute",
        "on-scroll-up": "swaymsg exec \\$volume_up",
        "on-scroll-down": "swaymsg exec \\$volume_down"
    },
}
